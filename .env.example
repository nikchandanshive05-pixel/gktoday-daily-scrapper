# Telegram Bot Credentials (Optional)
# Get token from @BotFather, chat ID from @userinfobot or channel username
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-1001234567890

# Discord Webhook URL (Optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Google Gemini API Key (Optional)
# Enables automated GS1-GS4 syllabus classification and Mains argument generation.
# If omitted, the engine uses the built-in deterministic heuristic NLP tagger.
GEMINI_API_KEY=AIzaSy...

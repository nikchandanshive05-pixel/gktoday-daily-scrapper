{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "replica-tokens",
  "version": "1.0.0",
  "color": {
    "bg": "#000000",
    "surface": "#121212",
    "surface-elevated": "#1E1E1E",
    "border": "#282828",
    "border-input": "#3F3F46",
    "text": "#FFFFFF",
    "text-muted": "#A1A1AA",
    "accent": "#06B6D4",
    "on-accent": "#000000",
    "danger": "#EF4444",
    "success": "#10B981",
    "warning": "#F59E0B",
    "overlay": "#000000"
  },
  "typography": {
    "fontFamily": {
      "sans": ["Inter", "system-ui", "-apple-system", "sans-serif"]
    },
    "fontSize": {
      "xs": ["12px", { "lineHeight": "16px" }],
      "sm": ["14px", { "lineHeight": "20px" }],
      "base": ["16px", { "lineHeight": "24px" }],
      "lg": ["18px", { "lineHeight": "28px" }],
      "xl": ["20px", { "lineHeight": "28px" }],
      "2xl": ["24px", { "lineHeight": "32px" }]
    },
    "fontWeight": {
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "2xl": "32px"
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "full": "9999px"
  },
  "pairs": [
    ["text", "bg"],
    ["text", "surface"],
    ["text", "surface-elevated"],
    ["text-muted", "bg"],
    ["text-muted", "surface"],
    ["on-accent", "accent"]
  ]
}
